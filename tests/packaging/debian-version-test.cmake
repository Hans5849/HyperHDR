# cmake -P tests/packaging/debian-version-test.cmake
include(${CMAKE_CURRENT_LIST_DIR}/../../cmake/cmake_modules/DebianVersion.cmake)

foreach(pair "24.0.0-beta.0=24.0.0~beta.0" "24.0.0=24.0.0" "22.1.0-alpha.3=22.1.0~alpha.3" " 24.0.0-beta.1 =24.0.0~beta.1")
	string(REPLACE "=" ";" parts "${pair}")
	list(GET parts 0 input)
	list(GET parts 1 expected)
	HyperhdrDebianVersion(actual "${input}")
	if(NOT actual STREQUAL expected)
		message(FATAL_ERROR "'${input}' -> '${actual}', expected '${expected}'")
	endif()
endforeach()

file(STRINGS ${CMAKE_CURRENT_LIST_DIR}/../../version source_version)
HyperhdrDebianVersion(current "${source_version}")

find_program(DPKG dpkg)
if(DPKG)
	set(ordered 24.0.0~alpha.1 24.0.0~beta.0 24.0.0~beta.1 24.0.0~beta.10 24.0.0 24.0.1~beta.0)
	list(LENGTH ordered n)
	math(EXPR last "${n} - 2")
	foreach(i RANGE ${last})
		math(EXPR j "${i} + 1")
		list(GET ordered ${i} a)
		list(GET ordered ${j} b)
		execute_process(COMMAND ${DPKG} --compare-versions ${a} lt ${b} RESULT_VARIABLE rc)
		if(NOT rc EQUAL 0)
			message(FATAL_ERROR "dpkg does not order ${a} < ${b}")
		endif()
	endforeach()
	execute_process(COMMAND ${DPKG} --validate-version ${current} RESULT_VARIABLE rc)
	if(NOT rc EQUAL 0)
		message(FATAL_ERROR "dpkg rejects ${current}")
	endif()
endif()
message(STATUS "Debian version mapping ok: ${source_version} -> ${current}")
